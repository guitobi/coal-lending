# Server Configuration
# Copy this file to .env and fill in your actual values

# Server Port
PORT=5000

# Frontend URLs (for CORS)
FRONTEND_URL=https://vanshare.pl
ALLOWED_ORIGINS=https://vanshare.pl,https://www.vanshare.pl,http://localhost:5173,http://localhost:4173

# Email Service (Resend API)
# Get your API key from https://resend.com/api-keys
# ⚠️ IMPORTANT: Keep this secret! Never commit the real .env file to git
RESEND_API_KEY=your-resend-api-key

# Email Configuration
MAIL_FROM=orders@vanshare.pl
EMAIL_TO=vanshare1@gmail.com
CONTACT_EMAIL_TO=vanshare1@gmail.com

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin API Key (for protected endpoints)
# Generate a secure random key: openssl rand -hex 32
# This protects admin endpoints like DELETE /api/heatmap
ADMIN_API_KEY=your_secure_random_key_here
